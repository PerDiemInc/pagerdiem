{
  "name": "pagerdiem",
  "version": "0.1.0",
  "description": "Self-hosted weekend on-call rotation and paging with Google sign-in and Slack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerDiemInc/pagerdiem.git"
  },
  "bugs": {
    "url": "https://github.com/PerDiemInc/pagerdiem/issues"
  },
  "homepage": "https://perdieminc.github.io/pagerdiem/",
  "keywords": [
    "on-call",
    "pager",
    "slack",
    "rotation",
    "incident",
    "self-hosted"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:pg": "TEST_DATABASE_URL=postgres://pagerdiem:pagerdiem@localhost:5432/pagerdiem_test node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
