# --- Basics ---
PORT=3000
# The public HTTPS URL people and Slack reach the app on (used in links and signature checks).
PUBLIC_URL=http://localhost:3000
# Long random string: openssl rand -hex 32  (required when NODE_ENV=production)
SESSION_SECRET=
# PostgreSQL (the default). `npm run db` starts this one with Docker; use your own URL in production.
DATABASE_URL=postgres://pagerdiem:pagerdiem@localhost:5432/pagerdiem
# Quick local try without Docker: clear DATABASE_URL above and use a SQLite file instead.
# DATABASE_PATH=data/pagerdiem.db
# --- Your company ---
# Only Google Workspace accounts with these email domains can sign in (comma-separated; required in production).
# This variable is the only place the domain is set; change it and restart to change who can sign in.
ALLOWED_EMAIL_DOMAINS=example.com
# Shown in the header, sign-in page and calendar feed.
TEAM_NAME=Example Engineering
APP_NAME=PagerDiem
# Google sign-in (OAuth client, type "Web application"). Without it, local dev uses email + password;
# production refuses to let anyone in until it's set.
# Redirect URI to register: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Weekend shift (team time zone) ---
TEAM_TIMEZONE=America/New_York
SHIFT_START=FRI 18:00
SHIFT_END=MON 09:00
# Or choose the days that need cover (these win over SHIFT_START/SHIFT_END when ON_CALL_DAYS is set):
#   ON_CALL_DAYS=FRI,SAT,SUN   ON_CALL_START=18:00   ON_CALL_END=09:00
#   PEOPLE_ON_WEEKEND_DAYS=2   PEOPLE_ON_WEEKDAYS=2
# An admin can change coverage and the sign-in domains later in Settings, which then wins over these.
REMINDER_HOURS_BEFORE=24
# People the rotation puts on each weekend (anyone can add themselves on top).
PEOPLE_PER_WEEKEND=2

# --- Paging ---
REPAGE_EVERY_MINUTES=5
ESCALATE_AFTER_MINUTES=15
# Bearer token for POST /api/incidents (Sentry, Coralogix, CI...). openssl rand -hex 24
# Secret behind the calendar feed link. Change it to revoke every existing link without logging anyone out.
# openssl rand -hex 24. Unset: derived from SESSION_SECRET, so old links keep working.
CALENDAR_FEED_SECRET=
API_TOKEN=

# --- Slack (leave blank for dry-run) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel ID for on-call announcements, e.g. C0123456789 (invite the bot to it).
SLACK_ONCALL_CHANNEL=
# The channel's name, only used in messages and logs (default on-call).
SLACK_ONCALL_CHANNEL_NAME=
# Your Slack workspace (team) ID, e.g. T0123456789. Requests from any other workspace are rejected.
# Required in production when Slack is connected (ALLOW_ANY_SLACK_WORKSPACE=true opts out; not recommended).
SLACK_TEAM_ID=
# User group ID (S0123456789) of @engineers, tagged when an incident is triggered. Falls back to @here/@channel.
SLACK_ENGINEERS_GROUP_ID=

# Team WhatsApp group invite link (https://chat.whatsapp.com/...), shown as a Join button. Keep it out of git.
WHATSAPP_GROUP_URL=

# --- Optional: the /ping AI check (off by default; see docs/ping.md) ---
PING_ENABLED=false
# Your Claude API key (https://console.anthropic.com). Or use PING_ROUTINE_URL + PING_ROUTINE_TOKEN for a Claude Code routine.
ANTHROPIC_API_KEY=
# Instructions the AI follows: replace skills/ping.md or point at your own file.
PING_SKILL_FILE=skills/ping.md
PING_MODEL=claude-sonnet-5-5
# Comma-separated health URLs to probe, e.g. https://api.example.com/health
PING_CHECK_URLS=
PING_COOLDOWN_SECONDS=120
PING_MAX_PER_DAY=30
PING_ROUTINE_URL=
PING_ROUTINE_TOKEN=
