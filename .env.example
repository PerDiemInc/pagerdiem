# --- Basics ---
PORT=3000
# The public HTTPS URL people and Slack/Twilio reach the app on (used in links and signature checks).
PUBLIC_URL=http://localhost:3000
# Long random string: openssl rand -hex 32  (required when NODE_ENV=production)
SESSION_SECRET=
DATABASE_PATH=data/pagerdiem.db
# --- Your company ---
# Only Google Workspace accounts with these email domains can sign in (comma-separated; required in production).
ALLOWED_EMAIL_DOMAINS=example.com
# Shown in the header, sign-in page and calendar feed.
TEAM_NAME=Example Engineering
APP_NAME=PagerDiem
# Google sign-in (OAuth client, type "Web application"). Without it, local dev uses email + password;
# production refuses to let anyone in until it's set.
# Redirect URI to register: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Weekend shift (team time zone) ---
TEAM_TIMEZONE=America/New_York
SHIFT_START=FRI 18:00
SHIFT_END=MON 09:00
REMINDER_HOURS_BEFORE=24
# People the rotation puts on each weekend (anyone can add themselves on top).
PEOPLE_PER_WEEKEND=2

# --- Paging ---
REPAGE_EVERY_MINUTES=5
ESCALATE_AFTER_MINUTES=15
# Bearer token for POST /api/incidents (Sentry, Coralogix, CI...). openssl rand -hex 24
API_TOKEN=

# --- Slack (leave blank for dry-run) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel ID for on-call announcements, e.g. C0123456789 (invite the bot to it).
SLACK_ONCALL_CHANNEL=
# Your Slack workspace (team) ID, e.g. T0123456789. Requests from any other workspace are rejected.
SLACK_TEAM_ID=
# User group ID (S0123456789) of @engineers, tagged when an incident is triggered. Falls back to @here/@channel.
SLACK_ENGINEERS_GROUP_ID=

# Team WhatsApp group invite link (https://chat.whatsapp.com/...), shown as a Join button. Keep it out of git.
WHATSAPP_GROUP_URL=

# --- WhatsApp via Twilio (leave blank for dry-run) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API key instead of the auth token for sending (auth token still verifies webhooks).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional approved WhatsApp templates (Content SIDs, HX...) so pages arrive outside the 24h window.
# Page template variables: {{1}} incident id, {{2}} title, {{3}} acknowledge link
TWILIO_PAGE_TEMPLATE_SID=
# Shift template variables: {{1}} shift start, {{2}} shift end
TWILIO_SHIFT_TEMPLATE_SID=
